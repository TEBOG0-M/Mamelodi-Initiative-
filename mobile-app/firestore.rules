rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Security rules for volunteer applications
    match /volunteer_applications/{applicationId} {

      // 1. Allow creation only if user is authenticated and is the owner of the record
      // 2. Validate that required fields are present
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.fullName != ""
                    && request.resource.data.email != "";

      // 3. Allow users to read only their own submissions
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      // 4. Protect records from unauthorized modification or deletion
      allow update, delete: if false;
    }
  }
}
